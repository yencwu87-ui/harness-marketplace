{
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "deny": [
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Read",
      "Grep",
      "Glob",
      "Read(**/.env*)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "disabled": false
    }
  }
}
