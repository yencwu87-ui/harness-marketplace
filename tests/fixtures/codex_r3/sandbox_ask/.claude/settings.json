{
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "deny": [
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Read",
      "Grep",
      "Glob"
    ],
    "ask": [
      "Bash(*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}