{
  "schema": "harness-track/1",
  "id": "dspy",
  "name": "DSPy",
  "language": "python",
  "support": "assess-only",
  "framework": {
    "package": "dspy",
    "version": "3.4.1"
  },
  "entry": null,
  "tool_hook": null,
  "reach_sources": [
    {
      "file": "**/*",
      "kind": "generic_declared"
    },
    {
      "file": ".env.example",
      "kind": "env_example"
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "import dspy"
    },
    {
      "file": "requirements*.txt",
      "contains": "dspy"
    }
  ],
  "notes": "Assess-only: detect and audit; no starter or trace hook in the kit yet."
}
