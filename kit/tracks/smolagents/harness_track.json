{
  "schema": "harness-track/1",
  "id": "smolagents",
  "name": "smolagents (Hugging Face)",
  "language": "python",
  "support": "assess-only",
  "framework": {
    "package": "smolagents",
    "version": "1.26.0"
  },
  "entry": null,
  "tool_hook": null,
  "reach_sources": [
    {
      "file": "**/*",
      "kind": "generic_declared"
    },
    {
      "file": ".env.example",
      "kind": "env_example"
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "from smolagents"
    },
    {
      "file": "requirements*.txt",
      "contains": "smolagents"
    }
  ],
  "notes": "Assess-only. Note: its CodeAgent executes model-written code; state how that is sandboxed."
}
