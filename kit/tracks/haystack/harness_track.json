{
  "schema": "harness-track/1",
  "id": "haystack",
  "name": "Haystack",
  "language": "python",
  "support": "assess-only",
  "framework": {
    "package": "haystack-ai",
    "version": "3.4.1"
  },
  "entry": null,
  "tool_hook": null,
  "reach_sources": [
    {
      "file": "**/*",
      "kind": "generic_declared"
    },
    {
      "file": ".env.example",
      "kind": "env_example"
    }
  ],
  "detect": [
    {
      "file": "**/*.py",
      "contains": "from haystack"
    },
    {
      "file": "requirements*.txt",
      "contains": "haystack-ai"
    }
  ],
  "notes": "Assess-only: detect and audit; no starter or trace hook in the kit yet."
}
