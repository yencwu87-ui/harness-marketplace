# Copy to .env and fill in only what your chosen track needs. Never commit .env.
# Which agent the test suites call: echo | claude-agent-sdk | microsoft-agent-framework | google-adk
KIT_TRACK=echo
KIT_REPO=.

# Claude (Anthropic API): Claude Code, Agent SDK, and the default for every track and judge
ANTHROPIC_API_KEY=
KIT_MODEL=opus                 # Claude Code / Agent SDK alias or full id
KIT_EFFORT=medium
KIT_MODEL_ID=claude-sonnet-5-5 # Microsoft Agent Framework model id

# Microsoft Agent Framework provider: anthropic | openai | foundry | ollama
KIT_PROVIDER=anthropic
OPENAI_API_KEY=
KIT_FOUNDRY_ENDPOINT=          # https://<project>.services.ai.azure.com (after `az login`)

# Google ADK model: claude-... | gemini-... | litellm:<provider/model>
KIT_ADK_MODEL=claude-sonnet-5-5
GOOGLE_API_KEY=

# Red-team judge: anthropic (default) or openai
KIT_JUDGE=anthropic
